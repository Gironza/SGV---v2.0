# Plantilla de configuracion de conexion a postgresql
# Cada quien usa su propio usuario y clave local de postgre 


DB_HOST=                       
# normalmente localhost
DB_USER=                       
# normalmente es postgres, aunque puede cambiar
DB_PASSWORD=                   
# la que usted tenga, contrasena del postgre
DB_NAME=SGV                      
 # nombre de la base tiene que ser SGV
DB_PORT=                       
#puerto que normalmente es el 5432

# Correo (RF-004 recuperar contraseña y RF-005 soporte)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=contraseña_de_aplicacion
SMTP_FROM=tu_correo@gmail.com
SOPORTE_DESTINO=tu_correo@gmail.com


#IMPORTANTE, una vez rellenado los campos de arriba cambien el nombre del archivo pasandolo de .env-ejemplo a .env 