# Plantilla de configuración. Copia este archivo a .env y llena tus valores.
# El .env real NUNCA se sube a GitHub.

# --- Seguridad: clave para firmar los JWT ---
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# --- Base de datos PostgreSQL ---
# Con docker compose, el host y la BD los define el compose; estas variables
# son para correr el backend directo en tu máquina.
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=SGV
DB_PORT=5432
# En local deja "prefer". En Supabase usa "require".
DB_SSLMODE=prefer

# --- CORS: orígenes del frontend, separados por coma, sin barra final ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# --- Correo (RF-004 recuperar contraseña y RF-005 soporte) ---
# Opcional. Sin estas variables el envío de correos responde 503 controlado.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=contraseña_de_aplicacion
SMTP_FROM=tu_correo@gmail.com
SOPORTE_DESTINO=tu_correo@gmail.com